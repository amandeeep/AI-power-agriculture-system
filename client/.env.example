# Copy to .env. Only VITE_* variables are exposed to the browser, so never put secrets here.
# No API keys are needed here. The defaults work as-is for local development.

# Base URL the browser uses for API calls. "/api" goes through the Vite dev proxy below.
VITE_API_BASE_URL=/api

# Dev-only: where the Vite dev server forwards /api requests (the Express server).
VITE_DEV_PROXY_TARGET=http://127.0.0.1:5000
VITE_DEV_PORT=5173

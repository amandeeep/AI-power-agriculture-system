# Copy to .env and fill in. Never commit .env.
# No external API keys are needed here. The only value to set is INTERNAL_API_KEY below.

ML_HOST=127.0.0.1
ML_PORT=8000

# Shared secret: Node server must send this in the X-Internal-Key header.
# Must match ML_INTERNAL_KEY in server/.env. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=change-me-to-a-long-random-string

# Paths are relative to the ml-service/ folder.
MODELS_DIR=models
KNOWLEDGE_DIR=knowledge

# Predictions below this confidence are returned as "uncertain".
DISEASE_CONFIDENCE_THRESHOLD=0.5

# Comma-separated origins allowed to call the service directly (normally only the Node server).
CORS_ORIGINS=http://localhost:5000

# Copy to .env and fill in. Never commit .env.
#
# ==========================================================================================
#  WHAT YOU NEED TO SET UP (only 2 external accounts, both free):
#
#  [REQUIRED] MONGODB_URI     MongoDB Atlas free M0 cluster  (needed from Phase 4: login, history, chat)
#             1. Sign up at https://www.mongodb.com/cloud/atlas/register
#             2. Create a free M0 cluster, then Database Access -> add a user + password
#             3. Network Access -> add your IP (or 0.0.0.0/0 for development)
#             4. Connect -> Drivers -> copy the "mongodb+srv://..." string, put your password in it,
#                and add the database name "agri_dss" before the "?"
#
#  [REQUIRED] GEMINI_API_KEY  Google Gemini API key, free tier  (needed from Phase 5: AI chat)
#             1. Go to https://aistudio.google.com/apikey (sign in with a Google account)
#             2. "Create API key" -> copy it here. Keep it server-side only.
#             Note: gemini-2.5-flash is closed to new API keys (Nov 2026). Default: gemini-3.1-flash-lite
#             (fast, separate free quota). gemini-3.5-flash gives richer answers but only ~20 requests/day free.
#             Without it, chat still works in "basic mode" (keyword fallback).
#
#  [GENERATE] JWT_SECRET, ML_INTERNAL_KEY  random strings, no account needed:
#             node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#             ML_INTERNAL_KEY must be IDENTICAL to INTERNAL_API_KEY in ml-service/.env
#
#  [NO KEY]   Open-Meteo weather + geocoding: free, no signup, nothing to set.
#  [OPTIONAL] Kaggle account: only for downloading datasets in the Colab notebook (Phase 3),
#             not used by this server.
# ==========================================================================================

NODE_ENV=development
PORT=5000

# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN=http://localhost:5173

# [REQUIRED] MongoDB Atlas. Example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/agri_dss?retryWrites=true&w=majority
MONGODB_URI=

# [GENERATE] JWT signing secret: long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Python ML service
ML_SERVICE_URL=http://127.0.0.1:8000
# [GENERATE] Must equal INTERNAL_API_KEY in ml-service/.env
ML_INTERNAL_KEY=change-me-to-a-long-random-string
ML_TIMEOUT_MS=20000

# [REQUIRED] Google Gemini (server-side only, never exposed to the client)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Gemini 3.x thinking level: minimal | low | medium | high. "minimal" = fastest and cheapest.
GEMINI_THINKING_LEVEL=minimal
GEMINI_TIMEOUT_MS=15000
# Per-attempt limit: a slow or 5xx Gemini call is retried once while the 15 s budget lasts
GEMINI_ATTEMPT_TIMEOUT_MS=8000

# [NO KEY] Open-Meteo (free, no key)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_CACHE_TTL_MS=1800000
# Historical climate normals (location-based crop recommendation). Free, no key.
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
CLIMATE_NORMAL_YEARS=10
# Address helpers for the location pickers (free, no keys): OpenStreetMap Photon (type-ahead),
# Nominatim (coordinates -> village/district/state; max 1 request/second), India Post (PIN codes).
PLACES_SEARCH_URL=https://photon.komoot.io/api
PLACES_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
PLACES_REVERSE_MIN_INTERVAL_MS=1100
PINCODE_URL=https://api.postalpincode.in/pincode
PLACES_USER_AGENT=agri-dss/0.1 (B.Tech student project)
# Radius for "popular in your area" counts (other farmers' crops, same season).
AREA_RADIUS_KM=25

# Rate limit for /api/chat (requests per window per IP)
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=10
